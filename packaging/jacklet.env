# Settings for the jacklet systemd service. This file is read by systemd as
# an EnvironmentFile, so each line is NAME=value -- no `export`, and no
# shell expansion. A package upgrade leaves it as you edited it.
#
# Every setting Jacklet has is listed by `jacklet --help` and documented in
# /usr/share/doc/jacklet/docs/configuration.md. Only the paths below differ
# from the built-in defaults: without them Jacklet would look for its
# definitions next to the executable, in /usr/bin, and write its database
# into the service's working directory.

JACKLET_DEFINITIONS_DIR=/var/lib/jacklet/definitions
JACKLET_CONFIG_DIR=/var/lib/jacklet/config
JACKLET_DB_PATH=/var/lib/jacklet/jacklet.db
JACKLET_PORT=9117

# Without an API key every indexer endpoint is open to anyone who can reach
# the port. Generate one with `openssl rand -hex 16`.
#JACKLET_API_KEY=

# External origin used in generated links; set this when Jacklet sits
# behind a TLS-terminating reverse proxy.
#JACKLET_BASE_URL=https://jacklet.example.com

# Operator address advertised in the Torznab caps and feed, which some
# clients show to the end user. Unset advertises none.
#JACKLET_CONTACT_EMAIL=ops@example.org

# Enables the /admin panel. Prefer the hash, from `jacklet hash-password`,
# so the plaintext password is not sitting in this file.
#JACKLET_ADMIN_PASSWORD_HASH=
