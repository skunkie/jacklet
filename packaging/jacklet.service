[Unit]
Description=Jacklet Torznab indexer proxy
Documentation=https://github.com/torrplay/jacklet
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=jacklet
Group=jacklet
EnvironmentFile=/etc/jacklet/jacklet.env
ExecStart=/usr/bin/jacklet
Restart=on-failure
RestartSec=5s

# Creates /var/lib/jacklet owned by the service user before ExecStart, so
# the database, the definitions and the per-indexer settings survive
# ProtectSystem=strict below, which leaves the rest of the filesystem
# read-only to this unit.
StateDirectory=jacklet
StateDirectoryMode=0750

# Jacklet makes outbound HTTP(S) requests, writes under its state
# directory and listens on a TCP port; it needs nothing else, so the rest
# is taken away. Binding a port below 1024 -- JACKLET_PORT=80 -- is the one
# thing this blocks that an operator might want: that needs
# AmbientCapabilities=CAP_NET_BIND_SERVICE and the same capability left in
# CapabilityBoundingSet, and a reverse proxy is the better answer.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Per-indexer settings hold tracker credentials in plaintext, and the
# database holds scraped listings; neither should be world-readable.
UMask=0077

[Install]
WantedBy=multi-user.target
